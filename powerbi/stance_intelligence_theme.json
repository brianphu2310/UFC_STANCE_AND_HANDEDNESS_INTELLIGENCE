{
  "name": "Stance Intelligence",
  "dataColors": ["#E5252D", "#3B82F6", "#E9B44C", "#2DBE8C", "#B8B8B8", "#6E6E72"],
  "background": "#0A0A0A",
  "foreground": "#F5F5F5",
  "tableAccent": "#E5252D",
  "good": "#2DBE8C",
  "neutral": "#E9B44C",
  "bad": "#E5252D",
  "maximum": "#FFB3B3",
  "center": "#B3121A",
  "minimum": "#2A0A0E",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#F5F5F5" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#F5F5F5" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#C8C8C8" },
    "callout": { "fontFace": "DIN", "fontSize": 32, "color": "#F5F5F5" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#151515" } }, "transparency": 14 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#2E2E30" } }, "radius": 0 }],
        "title": [{ "fontColor": { "solid": { "color": "#F5F5F5" } }, "fontSize": 12 }],
        "visualHeader": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0A0A0A" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#000000" } } }]
      }
    },
    "slicer": {
      "*": {
        "items": [{ "fontColor": { "solid": { "color": "#F5F5F5" } }, "background": { "solid": { "color": "#1F1F20" } } }],
        "header": [{ "fontColor": { "solid": { "color": "#8E8E8E" } } }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#C8C8C8" } }, "backColor": { "solid": { "color": "#1F1F20" } } }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#F5F5F5" } }, "backColorPrimary": { "solid": { "color": "#151515" } },
                    "fontColorSecondary": { "solid": { "color": "#F5F5F5" } }, "backColorSecondary": { "solid": { "color": "#1A1A1C" } } }],
        "grid": [{ "gridHorizontalColor": { "solid": { "color": "#2E2E30" } }, "gridVerticalColor": { "solid": { "color": "#2E2E30" } } }]
      }
    },
    "actionButton": {
      "*": {
        "fill": [{ "show": true, "fillColor": { "solid": { "color": "#151515" } } }],
        "text": [{ "show": true, "fontColor": { "solid": { "color": "#F5F5F5" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 10 }],
        "outline": [{ "show": true, "lineColor": { "solid": { "color": "#2E2E30" } } }]
      }
    }
  }
}
